# PostgreSQL
# Note: POSTGRES_PASSWORD is only applied when the postgres_data volume is first created.
# If you change this value later, update the role password in PostgreSQL or recreate the volume.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cortex_library
POSTGRES_USER=cortex_user
POSTGRES_PASSWORD=change_me_in_local_env

# Backend
BACKEND_PORT=3000
NODE_ENV=development

# ML Service
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://ml-service:8000

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000

# JWT (required for authentication; never commit a production secret)
JWT_SECRET=change_me_jwt_secret_in_local_env
JWT_EXPIRES_IN=7d
