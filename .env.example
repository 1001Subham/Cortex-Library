# PostgreSQL
# Note: POSTGRES_PASSWORD is only applied when the postgres_data volume is first created.
# If you change this value later, update the role password in PostgreSQL or recreate the volume.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cortex_library
POSTGRES_USER=cortex_user
POSTGRES_PASSWORD=change_me_in_local_env

# Backend
BACKEND_PORT=3000
NODE_ENV=development

# ML Service
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://ml-service:8000

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000

# JWT (required for authentication; never commit a production secret)
JWT_SECRET=change_me_jwt_secret_in_local_env
JWT_EXPIRES_IN=7d

# Token wallet (welcome allocation and default book-issue cost)
INITIAL_TOKEN_BALANCE=10
BOOK_ISSUE_TOKEN_COST=2

# Google OAuth Web client ID (required for the Continue with Google button).
# Create a Google Cloud OAuth 2.0 Client ID of type "Web application".
# Put the SAME client ID in both variables. Do not put the client secret in the frontend.
# Authorized JavaScript origins: http://localhost:5173
# Recreate frontend + backend containers after changing these values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google
VITE_GOOGLE_CLIENT_ID=
