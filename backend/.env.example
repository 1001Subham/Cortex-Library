# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
# Note: POSTGRES_PASSWORD is only applied when the postgres_data volume is first created.
# If you change this value later, update the role password in PostgreSQL or recreate the volume.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cortex_library
POSTGRES_USER=cortex_user
POSTGRES_PASSWORD=change_me_in_local_env

# ML Service
ML_SERVICE_URL=http://localhost:8000

# CORS
CORS_ORIGIN=http://localhost:5173

# Book files (directory that contains books/{id}/content.html)
# Default: <repo>/storage
BOOK_STORAGE_ROOT=

# JWT (required for authentication; never commit a production secret)
JWT_SECRET=change_me_jwt_secret_in_local_env
JWT_EXPIRES_IN=7d
ML_SERVICE_TOKEN=change_me_ml_service_token_in_local_env

# Token wallet
INITIAL_TOKEN_BALANCE=10
BOOK_ISSUE_TOKEN_COST=2

# Google OAuth Web client ID (verified server-side). Must match VITE_GOOGLE_CLIENT_ID.
# GOOGLE_CLIENT_SECRET is unused for the GIS ID-token button flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google
